# Скопируйте в .env (проще: ./scripts/init-env.sh создаст его со случайными секретами).
# Файл .env в Git не попадает. Значения-заглушки ниже НЕ подходят для запуска:
# платформа не стартует, пока SECRET_KEY короче 32 символов, а ADMIN_PASSWORD короче 12.
# Сгенерировать значение: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME
ADMIN_USERNAME=teacher
ADMIN_PASSWORD=CHANGE_ME

# Флаги заданий. Значения ДЕМОНСТРАЦИОННЫЕ: перед реальным турниром замените.
# Формат: CTF{буквы_цифры_-}. После смены: python3 tasks/build_tasks.py,
# затем docker compose up -d --build и ./scripts/seed.sh
WEB01_FLAG=CTF{idor_open_door_42}
WEB02_FLAG=CTF{view_source_is_not_a_crime}
CRYPTO01_FLAG=CTF{vigenere_needs_a_better_key}
