# Все параметры необязательны. Храните реальный .env приватно и вне Git.
# CYBERARENA_PORT=8080
# ADMIN_USERNAME=teacher
# ADMIN_PASSWORD=
# SECRET_KEY=
#
# При первом развёртывании пустые флаги генерируются случайно.
# Для ротации задайте уникальную ревизию. Оставляйте пустыми флаги, которые нужно сгенерировать.
# FLAG_REVISION=
# WEB01_FLAG=
# WEB02_FLAG=
# CRYPTO01_FLAG=
#
# Разрешайте сброс попыток и решений только в Compose-проекте с префиксом cyberarena-demo-.
# DEMO_RESET=false
